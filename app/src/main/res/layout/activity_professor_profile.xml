<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/backgroundColor"
    android:gravity="center">

    <!-- FrameLayout para la Imagen y el FloatingActionButton -->
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Imagen de Profesor -->
        <ImageView
            android:id="@+id/professorImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Profesor Imagen"
            android:scaleType="centerCrop"
            android:src="@drawable/professor_placeholder"/>

        <!-- Floating Action Button en la esquina inferior derecha -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabChangeImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            app:srcCompat="@android:drawable/ic_menu_camera" />

    </FrameLayout>

    <!-- Nombre del Profesor -->
    <TextView
        android:id="@+id/nameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del Profesor"
        android:textSize="22sp"
        android:textColor="@color/primaryColor"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Especialidad -->
    <TextView
        android:id="@+id/specialtyTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Especialidad: Salsa"
        android:textSize="16sp"
        android:textColor="@color/secondaryColor"
        android:layout_marginBottom="8dp"/>

    <!-- Descripción -->
    <TextView
        android:id="@+id/descriptionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción: Instructor con experiencia"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="16dp"/>

    <!-- Email -->
    <TextView
        android:id="@+id/emailTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email: profesor@correo.com"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="16dp"/>

    <!-- Botón para contactar -->
    <Button
        android:id="@+id/contactButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_background"
        android:text="Contactar Profesor"
        android:textColor="@android:color/white"
        app:icon="@android:drawable/ic_dialog_email" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_background"
        android:text="Volver"
        android:textColor="@android:color/white"
        app:icon="@android:drawable/ic_menu_revert" />
</LinearLayout>
