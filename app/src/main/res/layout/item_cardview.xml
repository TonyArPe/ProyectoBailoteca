<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/professorPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Posición"
        android:textSize="14sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/professorImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/professorName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del Profesor"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/professorSpecialty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Especialidad" />

    <RatingBar
        android:id="@+id/professorRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:rating="3.0" />

    <Button
        android:id="@+id/buttonContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contactar"
        app:icon="@android:drawable/sym_action_email" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#2196F3"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#000000" />

        <ImageButton
            android:id="@+id/buttonEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#009688"
            android:contentDescription="Editar"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="#CDDC39" />

        <ImageButton
            android:id="@+id/buttonDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#F44336"
            android:contentDescription="Eliminar"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#000000" />
    </LinearLayout>

    <TextView
        android:id="@+id/expandedDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalles Expandidos"
        android:visibility="gone" />

    <!-- Botones CRUD -->

</LinearLayout>
