<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/light_bg_color">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Imagen de fondo -->
        <ImageView
            android:id="@+id/imageViewBackground"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dance_background"
            android:alpha="0.7"/>

        <!-- Imagen del profesor -->
        <ImageView
            android:id="@+id/professorImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_background"
            android:scaleType="centerCrop"
            android:src="@drawable/professor_placeholder"/>

        <!-- Nombre del profesor -->
        <TextView
            android:id="@+id/professorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/professorImage"
            android:layout_marginStart="12dp"
            android:text="Nombre del Profesor"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <!-- Especialidad del profesor -->
        <TextView
            android:id="@+id/professorStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/professorName"
            android:layout_toEndOf="@id/professorImage"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            android:text="Especialidad"
            android:textSize="16sp"
            android:textColor="@android:color/darker_gray"/>

        <!-- Insignia de popularidad -->
        <ImageView
            android:id="@+id/imageViewIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/star_icon"
            android:layout_marginEnd="8dp"/>

        <!-- Calificación -->
        <RatingBar
            android:id="@+id/professorRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/professorStyle"
            android:layout_toEndOf="@id/professorImage"
            android:layout_marginTop="8dp"
            android:numStars="5"
            android:rating="4.5"
            android:stepSize="0.5"
            android:isIndicator="true"
            android:scaleX="0.8"
            android:scaleY="0.8"/>

        <!-- Botón de contacto -->
        <Button
            android:id="@+id/buttonContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/professorRating"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/primaryColor"
            android:text="Contactar"
            android:textColor="@android:color/white"/>

        <ImageView
            android:id="@+id/baileIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            app:srcCompat="@drawable/ic_baile_icon"
            app:tint="@android:color/holo_blue_light" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
