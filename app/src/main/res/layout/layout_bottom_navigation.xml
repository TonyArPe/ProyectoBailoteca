<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white"
    android:elevation="4dp">

    <TextView
        android:id="@+id/add_professor_option"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:drawableLeft="@android:drawable/ic_menu_add"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="Añadir Profesor"
        android:textColor="@color/purple_500"
        android:textSize="18sp" />

    <!-- Ejemplo de espacio para opciones futuras -->
    <TextView
        android:id="@+id/option_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opción futura"
        android:textSize="18sp"
        android:textColor="@color/gray"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:drawableLeft="@drawable/ic_placeholder"
        android:drawablePadding="8dp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone" />
</LinearLayout>
